# Copy to .env and fill in. deploy.sh reads this file automatically.

# --- Akto guardrails endpoint (required) ---
AKTO_DATA_INGESTION_URL=https://example.akto.io
AKTO_API_TOKEN=replace-with-your-akto-api-token
# Pin the exact immutable layer version published for your Lambda region.
AKTO_LAYER_ARN=arn:aws:lambda:us-east-1:041877753357:layer:akto-agentcore:3

# --- AWS (required) ---
# Region of your gateway(s) and the interceptor Lambda.
AWS_REGION=us-east-1

# One or more AgentCore gateway IDs to attach the interceptor to.
# Separate multiple with commas or spaces.
GATEWAY_IDS=gateway-quick-start-9080a8-j7mtt2zwul
# GATEWAY_IDS=gw-aaaaaaaaaa, gw-bbbbbbbbbb gw-cccccccccc

# --- Optional overrides (sensible defaults; uncomment to change) ---
# FUNCTION_NAME=akto-guardrails-interceptor
# LAMBDA_ROLE_NAME=akto-interceptor-lambda-role   # auto-created if missing
# LAMBDA_ROLE_ARN=                                # set to reuse an existing role (skips creation)
# LAMBDA_RUNTIME=python3.12
# Human approval can wait for at most Lambda's 15-minute synchronous limit.
# The defaults leave one minute for request handling and cleanup.
# LAMBDA_TIMEOUT=900
# AKTO_APPROVAL_WAIT_SECONDS=840
# AKTO_APPROVAL_POLL_SECONDS=2
# AKTO_TIMEOUT_SECONDS=30
# AKTO_FAIL_OPEN=false
# LAMBDA_MEMORY=256
